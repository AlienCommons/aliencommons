{
  "name": "frontend",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "api:check": "openapi-typescript ../backend/openapi/v1.yaml -o app/api/generated/v1.d.ts --check",
    "api:generate": "openapi-typescript ../backend/openapi/v1.yaml -o app/api/generated/v1.d.ts",
    "build": "nuxt build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "dev": "nuxt dev",
    "fmt:check": "vp fmt --check",
    "fmt:fix": "vp fmt",
    "generate": "nuxt generate",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "preview": "nuxt preview",
    "test": "vp test run",
    "test:e2e": "node ../../scripts/doctor.mjs --browser && playwright test",
    "typecheck": "vue-tsc --build --noEmit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/icon": "^2.5.1",
    "@pinia/nuxt": "^1.0.3",
    "alienmark": "workspace:*",
    "nuxt": "^4.6.1",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3"
  }
}
