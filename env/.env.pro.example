# Django
DJANGO_SETTINGS_MODULE=backend.settings.pro
SECRET_KEY=replace-with-a-random-production-secret
SITE_URL=https://aliencommons.com
ALLOWED_HOSTS=aliencommons.com,api.aliencommons.com
CORS_ALLOWED_ORIGINS=https://aliencommons.com

# Email
DEFAULT_FROM_EMAIL=replace-with-production-sender
SERVER_EMAIL=replace-with-production-server-email
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# PostgreSQL
POSTGRES_DB=aliencommons
POSTGRES_USER=aliencommons
POSTGRES_PASSWORD=replace-with-a-random-production-database-password
POSTGRES_HOST=postgres

# Redis
REDIS_PASSWORD=replace-with-a-random-production-redis-password
REDIS_URL=redis://:replace-with-a-random-production-redis-password@redis:6379/1
REDIS_KEY_PREFIX=aliencommons:pro

# Observability
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-production-grafana-password

# AWS media storage (provision in the Workloads/Pro member account)
AWS_STORAGE_BUCKET_NAME=replace-with-production-media-bucket
AWS_S3_REGION_NAME=ap-southeast-2
AWS_S3_CUSTOM_DOMAIN=media.aliencommons.com
