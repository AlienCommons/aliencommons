#!/usr/bin/env bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

if ! command -v curl >/dev/null 2>&1 ||
  ! command -v docker >/dev/null 2>&1 ||
  ! docker compose version >/dev/null 2>&1 ||
  ! command -v gpg >/dev/null 2>&1 ||
  ! command -v jq >/dev/null 2>&1 ||
  ! command -v openssl >/dev/null 2>&1 ||
  ! command -v unzip >/dev/null 2>&1; then
  apt-get update
  apt-get install -y ca-certificates curl docker.io docker-compose-v2 gnupg jq openssl unzip
fi

if ! command -v aws >/dev/null 2>&1; then
  aws_cli_directory=$(mktemp -d)
  trap 'rm -rf -- "${aws_cli_directory}"' EXIT
  curl --fail --location --silent --show-error \
    https://awscli.amazonaws.com/v2/install.sh \
    --output "${aws_cli_directory}/install.sh"
  bash "${aws_cli_directory}/install.sh" --system
  rm -rf -- "${aws_cli_directory}"
  trap - EXIT
fi

install -d -m 0755 /etc/docker
cat >/etc/docker/daemon.json <<'JSON'
{
  "live-restore": true,
  "log-driver": "json-file",
  "log-opts": {
    "max-file": "3",
    "max-size": "10m"
  }
}
JSON

systemctl enable --now docker
systemctl restart docker
usermod -aG docker ubuntu

install -d -m 0755 /srv/aliencommons
install -d -m 0700 /srv/aliencommons/origin-certs
install -d -m 0755 \
  /srv/aliencommons/stg \
  /srv/aliencommons/stg/alloy \
  /srv/aliencommons/stg/grafana \
  /srv/aliencommons/stg/loki \
  /srv/aliencommons/stg/static

if ! swapon --show=NAME --noheadings | grep -qx '/swapfile'; then
  if ! fallocate -l 2G /swapfile; then
    dd if=/dev/zero of=/swapfile bs=1M count=2048 status=progress
  fi
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi
